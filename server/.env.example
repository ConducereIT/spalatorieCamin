NODE_ENV=development
PORT=8881

# Local: npm run db (embedded Postgres). Production: the existing database.
DATABASE_URL=postgresql://admin:example@localhost:54329/rezervariCamin

# 32+ random characters: openssl rand -base64 48
BETTER_AUTH_SECRET=

# Public URL of the app. In development this is the Vite server, which
# proxies /api to this server, so cookies and OAuth stay on one origin.
BETTER_AUTH_URL=http://localhost:5173

# Google OAuth client. Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Number of reverse proxies in front of the server (0 = exposed directly).
TRUST_PROXY=0

# Show other residents' phone numbers on their bookings.
SHOW_PHONE_TO_RESIDENTS=false

# Built frontend to serve (production only), e.g. ../client/dist
STATIC_DIR=

# emails that can see the statistics page, separated by commas
ADMIN_EMAILS=
